@model SchoolApp.Models.Department

@{
    ViewData["Title"] = "Add Department";
}

<div class="container mt-4">
    <h2>Add New Department</h2>
    <div class="row mt-3">
        <div class="col-md-6">
            <form asp-controller="Department" asp-action="Add" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Department Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="MgrName" class="form-label">Manager Name</label>
                    <input asp-for="MgrName" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary">Save Department</button>
                <a asp-controller="Department" asp-action="ShowAll" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>