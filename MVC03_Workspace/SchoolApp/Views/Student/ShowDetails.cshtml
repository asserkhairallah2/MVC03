@model SchoolApp.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <h2>Student Details</h2>
    <div class="card mt-3" style="width: 25rem;">
        <div class="card-body">
            <h4 class="card-title text-primary">@Model.Name</h4>
            <h6 class="card-subtitle mb-3 text-muted">Student ID: @Model.Id</h6>
            <hr />
            <p class="card-text">
                <strong>Age:</strong> @Model.Age <br/>
                <strong>Department:</strong> @Model.Department?.Name
            </p>
            <a href="/Student/ShowAll" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>