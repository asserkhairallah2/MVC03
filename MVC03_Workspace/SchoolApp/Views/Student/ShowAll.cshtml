@model IEnumerable<SchoolApp.Models.Student>

@{
    ViewData["Title"] = "All Students";
}

<div class="container mt-4">
    <h2>All Students</h2>
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Department?.Name</td>
                    <td><a href="/Student/ShowDetails?id=@item.Id" class="btn btn-primary btn-sm">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>